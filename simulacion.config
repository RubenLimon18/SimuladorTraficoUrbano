# =============================================
# CONFIGURACIÓN DE SIMULACIÓN DE TRÁFICO URBANO
# =============================================

# CONFIGURACIÓN DE LA CIUDAD
ciudad.tamanio=12
ciudad.calles.doblesentido=true

# CONFIGURACIÓN DE VEHÍCULOS
vehiculos.cantidad=50
vehiculos.cantidad.min=20
vehiculos.cantidad.max=200
vehiculos.velocidad.base=1000

# CONFIGURACIÓN DE SEMÁFOROS
semaforo.verde=5
semaforo.amarillo=2
semaforo.rojo=6
semaforo.cantidad=15
semaforo.cantidad.min=10
semaforo.cantidad.max=20

# CONFIGURACIÓN DE SIMULACIÓN
simulacion.velocidad=1000
simulacion.mostrar.rutas=false
simulacion.mostrar.metricas=true
simulacion.log.detallado=false

# PUNTOS DE INTERÉS Y RUTAS
puntos.partida.bordes=true
puntos.destino.aleatorios=true

# ALGORITMOS Y RENDIMIENTO
algoritmo.ruta=A_STAR
planificacion.paralela=true
thread.pool.size=4

# MÉTRICAS Y ESTADÍSTICAS
metricas.tiempo.viaje=true
metricas.congestion=true
metricas.espera.semaforos=true
metricas.comparacion.paralelo=true